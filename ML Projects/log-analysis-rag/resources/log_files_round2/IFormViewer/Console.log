query executed from getDataFromDataSourceSELECT upper(INITCAP(sub_sub_sector)), INITCAP(sub_sub_sector)
FROM (
    SELECT DISTINCT
           TRIM(UPPER(sub_sub_sector)) AS sub_sub_sector
    FROM clos_mst_harmonized
    WHERE TRIM(UPPER(infra_sub_sector)) = TRIM(UPPER('DATA CENTERS'))
) t
ORDER BY
