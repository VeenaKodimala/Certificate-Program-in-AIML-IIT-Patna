nd from NG_CLOS_APPLICANT_DETAILS ad where ad.WI_NAME = get_var_str17_new('WF-0000001195-CLOS') and ad.HIDDEN_RELATIONSHIP like '%Borrower%' limit 1) as limit_id, null as parent_limit_id, null as FACILITY_TITLE, 'Yes' as limit_Applicable union all select 1 as order_col, null as LOS_Facility_ID, 'Yes' as Main_Facility, 'Fund Based' as FACILITY_TYPE, 'RTL' as FACILITY, 'INR' as Currency, null as CCY_Equi_Amt_In_Home_Curr, null::numeric as Equi_Amt_In_Home_Curr, coalesce((select SUM(sanc_amount::numeric) from NG_CLOS_EXISTING_FACILITY_CBS where wi_name = 'WF-0000001195-CLOS' and facility_type = 'Fund Based' and LOAN_ACC_NO not in (select LOAN_ACC_NO from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and LOAN_ACC_NO is not null )), 0) + coalesce((select SUM(approver_lmt) from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and nature_of_facility = 'Fund Based' and MAIN_FACILITY = 'Yes'), 0) as Proposed_Amount_Limit, coalesce((select SUM(sanc_amount::numeric) from NG_CLOS_EXISTING_FACILITY_CBS where wi_name = 'WF-0000001195-CLOS' and facility_type = 'Fund Based' and LOAN_ACC_NO not in (select LOAN_ACC_NO from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and LOAN_ACC_NO is not null)), 0) + coalesce((select SUM(approver_lmt) from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and nature_of_facility = 'Fund Based' and MAIN_FACILITY = 'Yes'), 0) as GrossAmtDisbursed, null as Main_Facility_ID, null as loan_acc_no, ( select case when exists ( select 1 from NG_CLOS_APPLICANT_DETAILS ad where ad.WI_NAME = get_var_str17_new('WF-0000001195-CLOS') and ad.HIDDEN_RELATIONSHIP like '%Borrower%' and ad.RELATIONSHIP_STATUS = 'Existing') and exists ( select 1 from NG_CLOS_EXISTING_FACILITY_CBS cbs where cbs.WI_NAME = 'WF-0000001195-CLOS') then 'Existing' else null end) as new_existing_flag, ( select case when ad.RELATIONSHIP_STATUS = 'Existing' and exists ( select 1 from NG_CLOS_EXISTING_FACILITY_CBS cbs where cbs.WI_NAME = ad.WI_NAME) then ad.CUSTOMER_ID || ' RTL' else null end from NG_CLOS_APPLICANT_DETAILS ad where ad.WI_NAME = get_var_str17_new('WF-0000001195-CLOS') and ad.HIDDEN_RELATIONSHIP like '%Borrower%' limit 1) as limit_id, null as parent_limit_id, null as FACILITY_TITLE, 'Yes' as limit_Applicable union all select 2 as order_col, null as LOS_Facility_ID, 'Yes' as Main_Facility, 'Non Fund Based' as FACILITY_TYPE, 'NF' as FACILITY, 'INR' as Currency, null as CCY_Equi_Amt_In_Home_Curr, null::numeric as Equi_Amt_In_Home_Curr, coalesce((select SUM(sanc_amount::numeric) from NG_CLOS_EXISTING_FACILITY_CBS where wi_name = 'WF-0000001195-CLOS' and facility_type = 'Non Fund Based' and LOAN_ACC_NO not in (select LOAN_ACC_NO from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and LOAN_ACC_NO is not null)), 0) + coalesce((select SUM(approver_lmt) from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and nature_of_facility = 'Non Fund Based' and MAIN_FACILITY = 'Yes'), 0) as Proposed_Amount_Limit, coalesce((select SUM(sanc_amount::numeric) from NG_CLOS_EXISTING_FACILITY_CBS where wi_name = 'WF-0000001195-CLOS' and facility_type = 'Non Fund Based' and LOAN_ACC_NO not in (select LOAN_ACC_NO from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and LOAN_ACC_NO is not null)), 0) + coalesce((select SUM(approver_lmt) from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and nature_of_facility = 'Non Fund Based' and MAIN_FACILITY = 'Yes'), 0) as GrossAmtDisbursed, null as Main_Facility_ID, null as loan_acc_no, ( select case when exists ( select 1 from NG_CLOS_APPLICANT_DETAILS ad where ad.WI_NAME = get_var_str17_new('WF-0000001195-CLOS') and ad.HIDDEN_RELATIONSHIP like '%Borrower%' and ad.RELATIONSHIP_STATUS = 'Existing') and exists ( select 1 from NG_CLOS_EXISTING_FACILITY_CBS cbs where cbs.WI_NAME = 'WF-0000001195-CLOS') then 'Existing' else null end) as new_existing_flag, ( select case when ad.RELATIONSHIP_STATUS = 'Existing' and exists ( select 1 from NG_CLOS_EXISTING_FACILITY_CBS cbs where cbs.WI_NAME = ad.WI_NAME) then ad.CUSTOMER_ID || ' NF' else null end from NG_CLOS_APPLICANT_DETAILS ad where ad.WI_NAME = get_var_str17_new('WF-0000001195-CLOS') and ad.HIDDEN_RELATIONSHIP like '%Borrower%' limit 1) as limit_id, null as parent_limit_id, null as FACILITY_TITLE, 'Yes' as limit_Applicable union all select distinct 4 as order_col, A.LOS_Facility_ID, A.Main_Facility, B.FACILITY_TYPE, B.FACILITY, A.Currency, A.currency as CCY_Equi_Amt_In_Home_Curr, A.equi_amt_in_home_curr as Equi_Amt_In_Home_Curr, A.Proposed_Amount_Limit, A.Proposed_Amount_Limit as GrossAmtDisbursed, A.Main_Facility_ID, A.loan_acc_no, A.new_exsisting_flag as new_existing_flag, A.limit_id, A.parent_limit_id, A.FACILITY_TITLE, CASE WHEN A.SUB_PRODUCT_TYPE NOT IN ('SP1','SP2','SP3','SP4','SP5','SP6','SP7') THEN 'Yes' ELSE 'No' END AS limit_Applicable from NG_CLOS_Borrower_NewLoans A join NGM_MSME_SCHEME_FACILITY B on A.SCHEME_ID = B.SCHEME_ID and A.Product = B.Facility_Code and A.PRODUCT_TYPE = B.PRODUCT_CODE and A.SUB_PRODUCT_TYPE = B.SUB_PRODUCT_CODE where A.WI_Name = 'WF-0000001195-CLOS') FINAL_DATA order by order_col
