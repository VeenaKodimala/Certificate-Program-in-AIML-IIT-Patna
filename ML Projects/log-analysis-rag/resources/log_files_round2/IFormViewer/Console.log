query executed from getDataFromDataSourceselect LOS_Facility_ID, Main_Facility, FACILITY_TYPE, FACILITY, Currency, CCY_Equi_Amt_In_Home_Curr, Equi_Amt_In_Home_Curr, Proposed_Amount_Limit, GrossAmtDisbursed, Main_Facility_ID, loan_acc_no, new_existing_flag, limit_id, parent_limit_id, FACILITY_TITLE from ( select 0 as order_col, null as LOS_Facility_ID, 'Yes' as Main_Facility, 'Total Proposed Exposure' as FACILITY_TYPE, 'TOT' as FACILITY, null as Currency, null as CCY_Equi_Amt_In_Home_Curr, null::numeric as Equi_Amt_In_Home_Curr, coalesce((select SUM(sanc_amount::numeric) from NG_CLOS_EXISTING_FACILITY_CBS where wi_name = 'WF-0000001195-CLOS' and LOAN_ACC_NO not in (select LOAN_ACC_NO from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and LOAN_ACC_NO is not null)), 0) + coalesce((select SUM(approver_lmt) from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and MAIN_FACILITY = 'Yes'), 0) as Proposed_Amount_Limit, coalesce((select SUM(sanc_amount::numeric) from NG_CLOS_EXISTING_FACILITY_CBS where wi_name = 'WF-0000001195-CLOS' and LOAN_ACC_NO not in (select LOAN_ACC_NO from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and LOAN_ACC_NO is not null)), 0) + coalesce((select SUM(approver_lmt) from ng_clos_borrower_newloans where WI_NAME = 'WF-0000001195-CLOS' and MAIN_FACILITY = 'Yes'), 0) as GrossAmtDisbursed, null as Main_Facility_ID, null as loan_acc_no, 'Existing' as new_existing_flag, ( select case when ad.RELATIONSHIP_STATUS = 'Existing' and exists ( select 1 from NG_CLOS_EXISTING_FACILITY_CBS cbs where cbs.WI_NAME = ad.WI_NAME ) then ad.CUSTOMER_ID || ' TOT' when ad.RELATIONSHIP_STATUS = 'NEW' then cif.CIF_NUMBER || ' TOT' else null end from NG_CLOS_APPLICANT_DETAILS ad left join NG_CLOS_CIF_CREATION cif on cif.WI_NAME = ad.WI_NAME where ad.WI_NAME = get_var_str17_new('WF-0000001195-CLOS') and ad.HIDDEN_RELATIONSHIP like '%Borrower%' limit 1 ) as limit_id, null as parent_limit_id, null as FACILITY_TITLE union all selec