query executed from getDataFromDataSourceSELECT 
    upper(sub_product) AS sub_product,
    sub_product_code
FROM (
    SELECT DISTINCT sub_product, sub_product_code
    FROM ngm_msme_scheme_facility
    WHERE product_code = 'P1'
) t
ORDER BY 
    CASE 
        WHEN UPPER(sub_product) = 'RUPEE TERM LOAN (RTL)' THEN 0
        WHEN UPPER(sub_product) = 'OTHERS' THEN 2
        ELSE 1
    END,
    UPPER(sub_product)
