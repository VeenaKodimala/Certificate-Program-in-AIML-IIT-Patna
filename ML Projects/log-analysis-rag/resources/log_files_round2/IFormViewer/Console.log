query executed from getDataFromDataSourceSELECT 
    UPPER(MASTER_DESC) AS MASTER_DESC,
    MASTER_CODE
FROM (
    SELECT DISTINCT MASTER_DESC, MASTER_CODE
    FROM NGM_MSME_YES_NO_MASTER
    WHERE ACTIVEFLAG = 'Y'
) t
ORDER BY 
    CASE 
        WHEN UPPER(MASTER_DESC) = 'YES' THEN 0
        WHEN UPPER(MASTER_DESC) = 'NO' THEN 2
        ELSE 1
    END,
    UPPER(MASTER_DESC) ASC
