query executed from saveDataInDataSource INSERT INTO NG_CLOS_EXISTING_FACILITY_CBS(insertionorderid,wi_name, Loan_Acc_No, product_type, facility_type, Product, Sanc_Amount, Disbursed_Amount, Current_Outstanding, applicable_roi, asset_classification, last_disbursement_amount, cif_number, scheme_code, as_on_date, interest_income, non_interest_income, limit_id, parent_limit_id,limit_amt) SELECT nextval('s_ng_clos_existing_facility_cb'),a.wi_name, a.Loan_Acc_No, CASE WHEN b.rec_count > 1 THEN NULL ELSE b.sub_product_code END, CASE WHEN b.rec_count > 1 THEN NULL ELSE b.facility_type END, CASE WHEN b.rec_count > 1 THEN NULL ELSE b.facility_code END, a.Sanc_Amount::numeric, a.Disbursed_Amount::numeric, a.Current_Outstanding::numeric, a.applicable_roi::numeric, a.asset_classification, a.last_disbursment_amount::numeric, a.cif, a.scheme_code, a.as_on_date::date, a.interestincomeamt, a.noninterestincomeamt, COALESCE(v.limit_id, ''), COALESCE(v.parent_limit_id, ''),COALESCE(v.sanction_limit, '') FROM NG_CLOS_LOANEXPOSURE a LEFT JOIN (SELECT scheme_code, sub_product_code, facility_type, facility_code, COUNT(*) OVER (PARTITION BY scheme_code) AS rec_count, ROW_NUMBER() OVER (PARTITION BY scheme_code ORDER BY scheme_code) AS rn FROM ngm_msme_scheme_facility) b ON a.scheme_code = b.scheme_code AND b.rn = 1 LEFT JOIN VIW_CLOS_LIMIT_ACCOUNT_MAPPING v ON a.wi_name = v.wi_name AND a.cif = v.customerid AND a.Loan_Acc_No = v.loan_acc_no WHERE a.wi_name = 'WF-0000001196-CLOS' AND a.cif = 'CORP000469' AND a.Loan_Acc_No NOT IN (SELECT Loan_Acc_No FROM NG_CLOS_EXISTING_FACILITY_CBS WHERE wi_name = 'WF-0000001196-CLOS');
