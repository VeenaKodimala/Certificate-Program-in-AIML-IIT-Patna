query executed from getDataFromDataSourceSELECT upper(infra_sub_sector),initcap(infra_sub_sector)
FROM (
    SELECT DISTINCT
           TRIM(INITCAP(infra_sub_sector)) AS infra_sub_sector
    FROM clos_mst_harmonized
    WHERE TRIM(UPPER(los_sector_id)) = TRIM(UPPER('SC0001'))
) t
ORDER BY
    (TRIM(infra_sub_sector) = 'Others'),
    TRIM(infra_sub_sector)
[22 Oct 2026 15:36:34,126] - 
query executed from getDataFromDataSourceSELECT upper(INITCAP(sub_sub_sector)), INITCAP(sub_sub_sector)
FROM (
    SELECT DISTINCT
           TRIM(UPPER(sub_sub_sector)) AS sub_sub_sector
    FROM clos_mst_harmonized
    WHERE TRIM(UPPER(infra_sub_sector)) = TRIM(UPPER('Roads And Bridges'))
) t
ORDER BY
    (TRIM(sub_sub_sector) = 'OTHERS'),
    TRIM(sub_sub_sector)
