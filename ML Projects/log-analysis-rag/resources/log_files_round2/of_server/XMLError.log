 [miriyalaudayakrishna] <WFReusableComponent_Input> <Option>WFSSelectWithColumnNames</Option> <EngineName>nabfid_dev</EngineName> <SessionID>590124254</SessionID> <Query>WITH base_data AS (SELECT A.*,B.MASTER_CODE AS MAIN_FACILITY,C.FACILITY_TYPE AS NATURE_OF_FACILITY,D.FACILITY_CODE AS PRODUCT,D.FACILITY_SHORT_CODE AS FACILITY_SHORT_CODE,G.SUB_PRODUCT_CODE AS SUB_PRODUCT_TYPE,E.MASTER_CODE AS TAKEOVER_CASE_CODE,F.TAKEOVER_CODE AS TAKEOVER_FROM_CODE FROM DLP_MGTN_CI_FD_STAGING A LEFT JOIN NGM_MSME_YES_NO_MASTER B ON UPPER(A.PARENT_FACILITY)=UPPER(B.MASTER_DESC) AND B.ACTIVEFLAG='Y' LEFT JOIN (SELECT DISTINCT SUB_PRODUCT,SUB_PRODUCT_CODE FROM NGM_MSME_SCHEME_FACILITY WHERE PRODUCT_CODE='P1' AND ACTIVEFLAG='Y') G ON UPPER(A.PRODUCT_TYPE)=UPPER(G.SUB_PRODUCT) LEFT JOIN NGM_MSME_SCHEME_FACILITY C ON UPPER(A.FACILITY_NATURE)=UPPER(C.FACILITY_TYPE) AND C.SUB_PRODUCT_CODE=G.SUB_PRODUCT_CODE AND C.ACTIVEFLAG='Y' LEFT JOIN NGM_MSME_SCHEME_FACILITY D ON UPPER(A.FACILITY_TYPE)=UPPER(D.FACILITY) AND D.SUB_PRODUCT_CODE=G.SUB_PRODUCT_CODE AND UPPER(D.FACILITY_TYPE)=UPPER(A.FACILITY_NATURE) AND D.ACTIVEFLAG='Y' LEFT JOIN NGM_CLOS_YES_NO_MASTER E ON UPPER(A.TAKEOVER_CASE)=UPPER(E.MASTER_DESC) AND E.ACTIVEFLAG='Y' LEFT JOIN CLOS_MST_TAKEOVER F ON UPPER(A.TAKEOVER_FROM)=UPPER(F.TAKEOVER_DESC) WHERE A.WORKITEM_NUMBER='MGTN--00000001-STAGING'), linked_facilities AS (SELECT DISTINCT F.FACILITY_ID FROM NGV_CLOS_LINKED_FACLITIES F INNER JOIN NG_CLOS_APPLICANT_DETAILS AD ON AD.WI_NAME=F.WI_NAME AND STRPOS(AD.HIDDEN_RELATIONSHIP,'##Borrower##')!=0 WHERE AD.GUARANTOR_ID=(SELECT AD2.GUARANTOR_ID FROM NG_CLOS_APPLICANT_DETAILS AD2 WHERE AD2.WI_NAME='MGTN--00000001-STAGING' AND STRPOS(AD2.HIDDEN_RELATIONSHIP,'##Borrower##')!=0 LIMIT 1) AND F.FACILITY_ID IS NOT NULL AND AD.WI_NAME='MGTN--00000001-STAGING'), existing_main AS (SELECT COALESCE(MAX(CAST(SPLIT_PART(FACILITY_ID,'-',1) AS INTEGER)),0) AS MAX_ID FROM linked_facilities WHERE SPLIT_PART(FACILITY_ID,'-',1) ~ '^[0-9]+$'), main_rows AS (SELECT BD.*,ROW_NUMBER() OVER(ORDER BY BD.FACILITY_TITLE,BD.PARENT_FACILITY_TITLE,BD.SUBLIMIT_OF) AS RN FROM base_data BD WHERE UPPER(BD.PARENT_FACILITY)='YES'), main_generated AS (SELECT MR.*,EM.MAX_ID+MR.RN AS GENERATED_MAIN_ID FROM main_rows MR CROSS JOIN existing_main EM), all_facilities AS (SELECT BD.*,MG.GENERATED_MAIN_ID FROM base_data BD LEFT JOIN main_generated MG ON MG.WORKITEM_NUMBER=BD.WORKITEM_NUMBER AND UPPER(MG.FACILITY_TITLE)=UPPER(BD.FACILITY_TITLE) AND COALESCE(MG.SUBLIMIT_OF,'')=COALESCE(BD.SUBLIMIT_OF,'') AND COALESCE(MG.PARENT_FACILITY_TITLE,'')=COALESCE(BD.PARENT_FACILITY_TITLE,'') WHERE UPPER(BD.PARENT_FACILITY)='YES' OR UPPER(BD.PARENT_FACILITY)='NO'), child_rows AS (SELECT C.*,P.GENERATED_MAIN_ID AS PARENT_MAIN_ID,ROW_NUMBER() OVER(PARTITION BY P.GENERATED_MAIN_ID ORDER BY C.FACILITY_TITLE,C.SUBLIMIT_OF) AS CHILD_RN FROM all_facilities C INNER JOIN all_facilities P ON UPPER(P.FACILITY_TITLE)=UPPER(C.PARENT_FACILITY_TITLE) AND UPPER(P.PARENT_FACILITY)='YES' WHERE UPPER(C.PARENT_FACILITY)='NO'), existing_child AS (SELECT CAST(SPLIT_PART(SPLIT_PART(FACILITY_ID,'-',1),'.',1) AS INTEGER) AS PARENT_ID,COALESCE(MAX(CAST(SPLIT_PART(SPLIT_PART(FACILITY_ID,'-',1),'.',2) AS INTEGER)),0) AS MAX_CHILD_ID FROM linked_facilities WHERE SPLIT_PART(FACILITY_ID,'-',1) ~ '^[0-9]+\.[0-9]+$' GROUP BY CAST(SPLIT_PART(SPLIT_PART(FACILITY_ID,'-',1),'.',1) AS INTEGER)), final_data AS (SELECT AF.*,CR.PARENT_MAIN_ID,CR.CHILD_RN,EC.MAX_CHILD_ID FROM all_facilities AF LEFT JOIN child_rows CR ON CR.WORKITEM_NUMBER=AF.WORKITEM_NUMBER AND UPPER(CR.FACILITY_TITLE)=UPPER(AF.FACILITY_TITLE) AND COALESCE(CR.SUBLIMIT_OF,'')=COALESCE(AF.SUBLIMIT_OF,'') AND COALESCE(CR.PARENT_FACILITY_TITLE,'')=COALESCE(AF.PARENT_FACILITY_TITLE,'') LEFT JOIN existing_child EC ON EC.PARENT_ID=CR.PARENT_MAIN_ID) SELECT '0' AS PID,'0' AS InsertionOrderId,B.MASTER_CODE AS Main_Facility,A.SUBLIMIT_OF AS Sub_Limit_of,A.PARENT_FACILITY_TITLE AS ParentFacilityTitle,A.SUB_PRODUCT AS SUBPRODUCT_DESC,C.FACILITY_TYPE AS Nature_of_Facility,D.FACILITY_CODE AS Product,A.FACILITY_TITLE AS facility_title,CASE WHEN UPPER(A.PARENT_FACILITY)='YES' THEN FD.GENERATED_MAIN_ID::VARCHAR||'-'||D.FACILITY_SHORT_CODE WHEN UPPER(A.PARENT_FACILITY)='NO' THEN FD.PARENT_MAIN_ID::VARCHAR||'.'||(COALESCE(FD.MAX_CHILD_ID,0)+FD.CHILD_RN)::VARCHAR||'-'||D.FACILITY_SHORT_CODE END AS LOS_Facility_ID,D.SCHEME_ID AS Scheme_Id,A.SPECIFY_OTHERS_FACILITY AS specify_others,A.CURRENCY AS Currency,A.PROPOSED_AMOUNT_LIMIT AS Proposed_Amount_Limit,A.CONVERSION_RATE AS Notional_Rate,A.EQUIVALENT_AMOUNT_IN_HOME_CURRENCY AS Equi_Amt_In_Home_Curr,A.MORATORIUM_IN_MONTHS AS moratorium_in_month_selected,A.REPAYMENT_PERIOD_IN_MONTHS AS repayment_in_month_selected,A.TENOR_IN_MONTHS AS tenor_in_month_selected,A.DETAILED_FACILITY_PURPOSE AS Detailed_Fac_Purpose,A.REIMBURSEMENT_ALLOWED AS REIMBURSEMENT_ALLOWED,A.PERCENT_OF_REIMBURSEMENT AS REIMBURSEMENT_PERC,TO_TIMESTAMP(A.EXPECTED_DATE_OF_FIRST_DISBURSEMENT,'DD/MM/YYYY') AS EXP_DISB_DATE,TO_TIMESTAMP(A.AVAILABILITY_PERIOD,'DD/MM/YYYY') AS Availability_Period,E.MASTER_CODE AS TAKEOVER_CASE,F.TAKEOVER_CODE AS takeover_from,G.SUB_PRODUCT_CODE AS SUB_PRODUCT_TYPE,A.LOAN_ACCOUNT_NUMBER AS loan_acc_no,A.DATE_OF_LAST_AQR_CMR AS aqr_date FROM final_data FD INNER JOIN DLP_MGTN_CI_FD_STAGING A ON A.WORKITEM_NUMBER=FD.WORKITEM_NUMBER AND UPPER(A.FACILITY_TITLE)=UPPER(FD.FACILITY_TITLE) AND COALESCE(A.SUBLIMIT_OF,'')=COALESCE(FD.SUBLIMIT_OF,'') AND COALESCE(A.PARENT_FACILITY_TITLE,'')=COALESCE(FD.PARENT_FACILITY_TITLE,'') LEFT JOIN NGM_MSME_YES_NO_MASTER B ON UPPER(A.PARENT_FACILITY)=UPPER(B.MASTER_DESC) AND B.ACTIVEFLAG='Y' LEFT JOIN (SELECT DISTINCT SUB_PRODUCT,SUB_PRODUCT_CODE FROM NGM_MSME_SCHEME_FACILITY WHERE PRODUCT_CODE='P1' AND ACTIVEFLAG='Y') G ON UPPER(A.PRODUCT_TYPE)=UPPER(G.SUB_PRODUCT) LEFT JOIN NGM_MSME_SCHEME_FACILITY C ON UPPER(A.FACILITY_NATURE)=UPPER(C.FACILITY_TYPE) AND C.SUB_PRODUCT_CODE=G.SUB_PRODUCT_CODE AND C.ACTIVEFLAG='Y' LEFT JOIN NGM_MSME_SCHEME_FACILITY D ON UPPER(A.FACILITY_TYPE)=UPPER(D.FACILITY) AND D.SUB_PRODUCT_CODE=G.SUB_PRODUCT_CODE AND UPPER(D.FACILITY_TYPE)=UPPER(A.FACILITY_NATURE) AND D.ACTIVEFLAG='Y' LEFT JOIN NGM_CLOS_YES_NO_MASTER E ON UPPER(A.TAKEOVER_CASE)=UPPER(E.MASTER_DESC) AND E.ACTIVEFLAG='Y' LEFT JOIN CLOS_MST_TAKEOVER F ON UPPER(A.TAKEOVER_FROM)=UPPER(F.TAKEOVER_DESC) WHERE A.WORKITEM_NUMBER='MGTN--00000001-STAGING'</Query> <TableName>dual</TableName> </WFReusableComponent_Input>

